    "pi-package",
    "pi",
    "pi-extension",
    "skill",
    "skills",
    "autocomplete",
    "completion",
    "mention",
    "opencode"
  ],
  "license": "MIT",
  "author": "Ttungx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ttungx/pi-at-skills.git"
  },
  "homepage": "https://github.com/Ttungx/pi-at-skills#readme",
  "bugs": {
    "url": "https://github.com/Ttungx/pi-at-skills/issues"
  },
  "engines": {
    "node": ">=22.19"
  },
  "files": [
    "src",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "prepublishOnly": "npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/Ttungx/pi-at-skills/main/media/preview.png"
  }
